# Magic_Hook by DYL - Environment Variables
#
# Copy this file to `.env` (or export these in your shell) and replace the
# placeholders below with your real values. Never commit the real `.env`.
#
# These keys are read by magic_proxy.py (the dynamic routing proxy).
# The hooks (magic_score.py / magic_submit.py) read provider names from your
# cc-switch UI, not from these keys, so they don't need anything here.

# ---------------------------------------------------------------------------
# BASE / LOCAL model
# ---------------------------------------------------------------------------
# Local model key (your self-hosted / local gateway).
LOCAL_API_KEY=REPLACE_WITH_YOUR_LOCAL_API_KEY

# Local model upstream URL (e.g. http://127.0.0.1:PORT/v1).
LOCAL_BASE_URL=REPLACE_WITH_YOUR_LOCAL_BASE_URL

# Model name you request from the base model.
LOCAL_MODEL_NAME=REPLACE_WITH_YOUR_LOCAL_MODEL_NAME

# ---------------------------------------------------------------------------
# CLOUD PRIMARY model (your strong cloud model)
# ---------------------------------------------------------------------------
CLOUD_PRIMARY_API_KEY=REPLACE_WITH_YOUR_CLOUD_PRIMARY_API_KEY
CLOUD_PRIMARY_URL=REPLACE_WITH_YOUR_CLOUD_PRIMARY_URL
CLOUD_PRIMARY_MODEL=REPLACE_WITH_YOUR_CLOUD_PRIMARY_MODEL

# ---------------------------------------------------------------------------
# CLOUD BACKUP model (tried if primary fails) - set to empty to disable
# ---------------------------------------------------------------------------
CLOUD_BACKUP_API_KEY=REPLACE_WITH_YOUR_CLOUD_BACKUP_API_KEY
CLOUD_BACKUP_URL=REPLACE_WITH_YOUR_CLOUD_BACKUP_URL
CLOUD_BACKUP_MODEL=REPLACE_WITH_YOUR_CLOUD_BACKUP_MODEL
